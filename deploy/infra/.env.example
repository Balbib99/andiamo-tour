# Copia este archivo a ".env" en ~/homelab/infra y rellena los valores. El ".env" real no se sube a git.
# Las tres líneas DUCKDNS_API_TOKEN, ADMIN_USER y ADMIN_PASSWORD_HASH cópialas TAL CUAL del .env de lista-compra-nfc
# (el hash lleva signos $ y, si ya funcionaba allí, tiene que quedar igual aquí).

DUCKDNS_API_TOKEN=
ADMIN_USER=
ADMIN_PASSWORD_HASH=

# Lista de la compra (los de antes)
DESPENSA_DOMAIN=despensa4b.duckdns.org
DESPENSA_SUBDOMAIN=despensa4b

# Andiamo: crea este subdominio en duckdns.org (con tu cuenta) y ponlo aquí
ANDIAMO_DOMAIN=
ANDIAMO_SUBDOMAIN=
