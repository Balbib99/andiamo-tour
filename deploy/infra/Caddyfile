# Un bloque por web. Los destinos son alias de la red "edge", no nombres de contenedor.

# Lista de la compra (PocketBase). Es el bloque que ya tenías, con el dominio en otra variable.
{$DESPENSA_DOMAIN} {
	tls {
		dns duckdns {env.DUCKDNS_API_TOKEN}
	}

	basic_auth /_/* {
		{$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
	}

	reverse_proxy despensa-pocketbase:8090
}

# Andiamo
{$ANDIAMO_DOMAIN} {
	tls {
		dns duckdns {env.DUCKDNS_API_TOKEN}
	}

	encode zstd gzip
	reverse_proxy andiamo-web:80
}
